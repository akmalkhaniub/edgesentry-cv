{
  "name": "edgesentry-cv",
  "version": "1.0.0",
  "description": "Edge Computer Vision & Serverless Industrial Hazard Sentinel for OpenCV AI AWS Hackathon",
  "main": "src/spatial_hazard_detector.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
